*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:#f5f9fd;color:#15344e;font:17px/1.7 system-ui,sans-serif}a{color:#075cad;text-underline-offset:4px}a:hover{color:#053963}a:focus-visible,button:focus-visible,input:focus-visible,summary:focus-visible{outline:3px solid #b36d00;outline-offset:4px}header{background:white;border-bottom:1px solid #bdd8f4;padding:20px max(5%,calc((100% - 1180px)/2))}.brand{font-size:21px;font-weight:750;color:#082f53;text-decoration:none}nav{display:flex;gap:8px 22px;flex-wrap:wrap;margin-top:12px;font-size:14px}nav a[aria-current]{font-weight:800}main{max-width:1180px;margin:auto;padding:42px 24px 70px}h1,h2,h3{color:#082f53;line-height:1.2}h1{font-size:clamp(36px,5vw,64px);letter-spacing:-.045em;margin:10px 0 20px}h2{font-size:29px;margin-top:0}h3{font-size:21px}p{margin:12px 0}.eyebrow{font-weight:750;font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:#075cad}.intro{max-width:820px;font-size:20px}.hero{display:grid;grid-template-columns:1fr 280px;gap:40px;align-items:center;margin-bottom:38px}.hero img{width:100%;border-radius:16px}.actions{display:flex;gap:12px;flex-wrap:wrap;margin:24px 0}.button{display:inline-block;padding:11px 19px;border-radius:7px;background:#075cad;color:white;text-decoration:none;font-weight:700}.button:hover{color:white;background:#082f53}.secondary{background:white;color:#075cad;border:1px solid #075cad}.secondary:hover{color:white}.grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}.two{grid-template-columns:repeat(2,minmax(0,1fr))}.card,section.panel{background:white;border:1px solid #bdd8f4;border-radius:12px;padding:25px}section{margin:32px 0}.card h3{margin-top:0}.stat{font-size:36px;font-weight:800;color:#075cad;display:block}.note{padding:16px 20px;border-left:4px solid #8ca62b;background:#eef4e1;font-size:15px}.muted{color:#506479;font-size:15px}li{margin:8px 0}details{background:white;border:1px solid #bdd8f4;border-radius:10px;margin:1