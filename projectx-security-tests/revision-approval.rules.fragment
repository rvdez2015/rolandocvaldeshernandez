// PROPOSED ONLY. Emulator validation required. Never deploy in isolation.
// Owner-private approved revisions and pointer must remain mutually consistent.
function isRevisionOwner() {
  return request.auth != null && request.auth.uid == 'UnsKCIgOTBbbVfGYy9ATeuIaRZ53';
}
function isRevisionLessonId(lessonId) {
  return lessonId.matches('^PX25-Y11-U[0-9]{2}-L[0-9]{3}$');
}
function approvedProposalMatches(lessonId, proposalId) {
  return exists(/databases/$(database)/documents/ownerCurriculumReviewDrafts/$(lessonId)/versions/$(proposalId))
    && get(/databases/$(database)/documents/ownerCurriculumReviewDrafts/$(lessonId)/versions/$(proposalId)).data.lessonId == lessonId
    && get(/databases/$(database)/documents/ownerCurriculumReviewDrafts/$(lessonId)/versions/$(proposalId)).data.revisionId == proposalId
    && get(/databases/$(database)/documents/ownerCurriculumReviewDrafts/$(lessonId)/versions/$(proposalId)).data.createdByUid == request.auth.uid
    && get(/databases/$(database)/documents/ownerCurriculumReviewDrafts/$(lessonId)/versions/$(proposalId)).data.status == 'review_draft'
    && get(/databases/$(database)/documents/ownerCurriculumReviewDrafts/$(lessonId)/versions/$(proposalId)).data.schema == 'projectx-curriculum-review-proposal-v1'
    && get(/databases/$(database)/documents/ownerCurriculumReviewDrafts/$(lessonId)/versions/$(proposalId)).data.sourceReleaseId == 'y11-j277-canonical-pilot-20261024-r1'
    && get(/databases/$(database)/documents/ownerCurriculumReviewDrafts/$(lessonId)/versions/$(proposalId)).data.schoolId == 'project-x-personal'
    && get(/databases/$(database)/documents/ownerCurriculumReviewDrafts/$(lessonId)/versions/$(proposalId)).data.sourceFingerprint.matches('^[a-f0-9]{64}$')
    && get(/databases/$(database)/documents/ownerCurriculumReviewDrafts/$(lessonId)/versions/$(proposalId)).data.studentPublished == false;
}
function approvedVersionMatches(lessonId, revisionId) {
  return existsAfter(/databases/$(database)/documents/ownerApprovedCurriculumLessons/$(lessonId)/versions/$(revisionId))
    && getAfter(/databases/$(database)/documents/ownerApprovedCurriculumLessons/$(lessonId)/versions/$(revisionId)).data.lessonId == lessonId
    && getAfter(/databases/$(database)/documents/ownerApprovedCurriculumLessons/$(lessonId)/versions/$(revisionId)).data.revisionId == revisionId
    && getAfter(/databases/$(database)/documents/ownerApprovedCurriculumLessons/$(lessonId)/versions/$(revisionId)).data.approvedByUid == request.auth.uid
    && getAfter(/databases/$(database)/documents/ownerApprovedCurriculumLessons/$(lessonId)/versions/$(revisionId)).data.studentPublished == false;
}
match /ownerApprovedCurriculumLessons/{lessonId} {
  allow get: if isRevisionOwner() && isRevisionLessonId(lessonId);
  allow list, delete: if false;
  allow create, update: if isRevisionOwner() && isRevisionLessonId(lessonId)
    && request.resource.data.keys().hasOnly(['lessonId','schoolId','latestApprovedRevisionId','previousApprovedRevisionId','approvedByUid','updatedAt','classroomSyncStatus'])
    && request.resource.data.lessonId == lessonId
    && request.resource.data.schoolId == 'project-x-personal'
    && request.resource.data.approvedByUid == request.auth.uid
    && request.resource.data.updatedAt == request.time
    && request.resource.data.classroomSyncStatus == 'pending_student_projection'
    && request.resource.data.latestApprovedRevisionId.matches('^approved-[a-zA-Z0-9_-]{1,150}$')
    && approvedVersionMatches(lessonId,request.resource.data.latestApprovedRevisionId)
    && (
      (!exists(/databases/$(database)/documents/ownerApprovedCurriculumLessons/$(lessonId))
       && request.resource.data.previousApprovedRevisionId == null)
      ||
      (exists(/databases/$(database)/documents/ownerApprovedCurriculumLessons/$(lessonId))
       && request.resource.data.previousApprovedRevisionId == resource.data.latestApprovedRevisionId)
    );
}
match /ownerApprovedCurriculumLessons/{lessonId}/versions/{revisionId} {
  allow get, list: if isRevisionOwner() && isRevisionLessonId(lessonId);
  allow create: if isRevisionOwner() && isRevisionLessonId(lessonId)
    && revisionId.matches('^approved-[a-zA-Z0-9_-]{1,150}$')
    && request.resource.data.lessonId == lessonId
    && request.resource.data.revisionId == revisionId
    && request.resource.data.approvedByUid == request.auth.uid
    && request.resource.data.schoolId == 'project-x-personal'
    && request.resource.data.visibility == 'owner_private'
    && request.resource.data.studentPublished == false
    && request.resource.data.classroomSyncStatus == 'not_requested'
    && request.resource.data.approvalStatus == 'approved'
    && request.resource.data.approvedProposalId is string
    && request.resource.data.approvedProposalId.size() > 0
    && request.resource.data.parentRevisionId == 'y11-j277-canonical-pilot-20261024-r1'
    && request.resource.data.revisionId == 'approved-' + request.resource.data.approvedProposalId
    && approvedProposalMatches(lessonId,request.resource.data.approvedProposalId);
  allow update, delete: if false;
}
